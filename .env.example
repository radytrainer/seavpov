# Copy to .env (never commit .env). Values below are for LOCAL DEVELOPMENT only.

# --- Runtime -------------------------------------------------------------
NODE_ENV=development
LOG_LEVEL=info

# --- Database (docker compose "db" service publishes 5440 on localhost) --
POSTGRES_USER=reading
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=reading_tracker
DATABASE_URL=postgresql://reading:change-me-local-only@127.0.0.1:5440/reading_tracker?schema=public
# Separate database used by integration tests (created by infra/postgres/init.sql)
TEST_DATABASE_URL=postgresql://reading:change-me-local-only@127.0.0.1:5440/reading_tracker_test?schema=public
# Max pooled connections per API process
DATABASE_POOL_MAX=10

# --- API -----------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=4010
# Public origin of the web app (used for CSRF origin checks and reset links)
APP_ORIGIN=http://localhost:3000
# Secure cookies require HTTPS; set to true in production
COOKIE_SECURE=false
SESSION_TTL_HOURS=168
# Expose Swagger UI at /api/docs (disable in production if not needed)
API_DOCS_ENABLED=true
# Sign-in attempts per client IP per minute. Students behind one school NAT share an IP:
# raise this if a whole class signs in at once. Per-account lockout still applies.
AUTH_RATE_LIMIT_PER_MINUTE=30
# Other API requests per signed-in session (or per IP when signed out) per minute
GLOBAL_RATE_LIMIT_PER_MINUTE=600

# --- Web (Next.js) ---------------------------------------------------------
# Server-side URL the Next.js server uses to reach the API (internal network).
# Use 127.0.0.1 rather than localhost locally: "localhost" may resolve to IPv6 first and add
# ~200 ms to every request.
API_INTERNAL_URL=http://127.0.0.1:4010
# Time zone used to display dates; must match the institution time zone in admin settings.
NEXT_PUBLIC_TIME_ZONE=Asia/Phnom_Penh

# --- Email (optional; password-reset emails). Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Reading Tracker <no-reply@example.edu>"

# --- Seed (development only; production uses scripts/create-admin) --------
SEED_DEFAULT_PASSWORD=Password123!
