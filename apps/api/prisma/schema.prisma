// Physical Book Reading Tracker — database schema.
// Conventions: snake_case tables/columns, UUID ids, timestamptz (UTC). See docs/DATABASE.md.
// Partial unique index for "one active session per student" is added in migration SQL.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  STUDENT
  TRAINER
  ADMIN
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNDISCLOSED
}

enum CatalogStatus {
  APPROVED
  PENDING
}

enum ReadingStatus {
  PLANNED
  READING
  PAUSED
  COMPLETED
  ABANDONED
}

enum SessionStatus {
  READING
  PAUSED
  COMPLETED
  CANCELLED
}

enum SessionSource {
  TIMER
  MANUAL
}

enum ReadingMethod {
  PHYSICAL_BOOK
}

// ---------------------------------------------------------------------------
// People and organisation
// ---------------------------------------------------------------------------

model Generation {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique @db.VarChar(100)
  startYear  Int?      @map("start_year")
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  classes Class[]

  @@map("generations")
}

model Class {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(100)
  generationId String    @map("generation_id") @db.Uuid
  archivedAt   DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  generation Generation @relation(fields: [generationId], references: [id], onDelete: Restrict)
  students   User[]

  @@unique([generationId, name])
  @@map("classes")
}

model User {
  id                 String     @id @default(uuid()) @db.Uuid
  role               Role
  status             UserStatus @default(ACTIVE)
  /// Login name, stored lowercase.
  username           String     @unique @db.VarChar(64)
  /// Stored lowercase.
  email              String?    @unique @db.VarChar(254)
  /// Institution student ID (students only).
  studentCode        String?    @unique @map("student_code") @db.VarChar(32)
  fullName           String     @map("full_name") @db.VarChar(150)
  gender             Gender?
  classId            String?    @map("class_id") @db.Uuid
  passwordHash       String     @map("password_hash")
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  failedLoginCount   Int        @default(0) @map("failed_login_count")
  lockedUntil        DateTime?  @map("locked_until") @db.Timestamptz(3)
  lastLoginAt        DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt          DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  class               Class?                     @relation(fields: [classId], references: [id], onDelete: SetNull)
  authSessions        AuthSession[]
  resetTokens         PasswordResetToken[]
  trainerAssignments  TrainerStudentAssignment[] @relation("AssignmentTrainer")
  studentAssignments  TrainerStudentAssignment[] @relation("AssignmentStudent")
  studentBooks        StudentBook[]
  readingSessions     ReadingSession[]
  reflections         ReadingReflection[]
  feedbackGiven       TrainerFeedback[]
  readingGoals        ReadingGoal[]
  createdLibraryBooks LibraryBook[]
  auditLogs           AuditLog[]

  @@index([role, status])
  @@index([classId])
  @@map("users")
}

model AuthSession {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  /// SHA-256 of the opaque cookie token; the raw token is never stored.
  tokenHash  String   @unique @map("token_hash") @db.Char(64)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  ip         String?  @db.VarChar(64)
  userAgent  String?  @map("user_agent") @db.VarChar(300)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

model TrainerStudentAssignment {
  id        String   @id @default(uuid()) @db.Uuid
  trainerId String   @map("trainer_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  trainer User @relation("AssignmentTrainer", fields: [trainerId], references: [id], onDelete: Cascade)
  student User @relation("AssignmentStudent", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([trainerId, studentId])
  @@index([studentId])
  @@map("trainer_student_assignments")
}

// ---------------------------------------------------------------------------
// Books
// ---------------------------------------------------------------------------

model BookCategory {
  id         String    @id @default(uuid()) @db.Uuid
  name       String    @unique @db.VarChar(100)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  books LibraryBook[]

  @@map("book_categories")
}

/// Shared catalog of physical library books.
model LibraryBook {
  id            String        @id @default(uuid()) @db.Uuid
  title         String        @db.VarChar(300)
  author        String?       @db.VarChar(200)
  /// lower(trim(title)) + '|' + lower(trim(author)) for duplicate detection.
  normalizedKey String        @map("normalized_key") @db.VarChar(510)
  categoryId    String?       @map("category_id") @db.Uuid
  isbn          String?       @unique @db.VarChar(20)
  libraryCode   String?       @unique @map("library_code") @db.VarChar(50)
  totalPages    Int?          @map("total_pages")
  coverImageUrl String?       @map("cover_image_url") @db.VarChar(500)
  status        CatalogStatus @default(APPROVED)
  createdById   String?       @map("created_by_id") @db.Uuid
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category     BookCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdBy    User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  studentBooks StudentBook[]

  @@index([normalizedKey])
  @@index([categoryId])
  @@index([status])
  @@map("library_books")
}

/// A student's personal reading record for one catalog book.
model StudentBook {
  id            String        @id @default(uuid()) @db.Uuid
  studentId     String        @map("student_id") @db.Uuid
  libraryBookId String        @map("library_book_id") @db.Uuid
  status        ReadingStatus @default(PLANNED)
  currentPage   Int           @default(0) @map("current_page")
  /// Overrides the catalog page count (different edition).
  totalPages    Int?          @map("total_pages")
  notes         String?       @db.VarChar(2000)
  startedAt     DateTime?     @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?     @map("completed_at") @db.Timestamptz(3)
  lastReadAt    DateTime?     @map("last_read_at") @db.Timestamptz(3)
  archivedAt    DateTime?     @map("archived_at") @db.Timestamptz(3)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     User             @relation(fields: [studentId], references: [id], onDelete: Restrict)
  libraryBook LibraryBook      @relation(fields: [libraryBookId], references: [id], onDelete: Restrict)
  sessions    ReadingSession[]

  @@unique([studentId, libraryBookId])
  @@index([studentId, status])
  @@index([studentId, lastReadAt])
  @@map("student_books")
}

// ---------------------------------------------------------------------------
// Reading activity
// ---------------------------------------------------------------------------

model ReadingSession {
  id              String        @id @default(uuid()) @db.Uuid
  studentId       String        @map("student_id") @db.Uuid
  studentBookId   String        @map("student_book_id") @db.Uuid
  source          SessionSource @default(TIMER)
  method          ReadingMethod @default(PHYSICAL_BOOK)
  status          SessionStatus
  startedAt       DateTime      @map("started_at") @db.Timestamptz(3)
  endedAt         DateTime?     @map("ended_at") @db.Timestamptz(3)
  /// Start of the current running segment; null while paused or finished.
  lastResumedAt   DateTime?     @map("last_resumed_at") @db.Timestamptz(3)
  /// Accumulated active reading seconds (server-computed).
  durationSeconds Int           @default(0) @map("duration_seconds")
  durationCapped  Boolean       @default(false) @map("duration_capped")
  /// Local date (institution time zone) the session counts toward.
  readingDate     DateTime      @map("reading_date") @db.Date
  startPage       Int?          @map("start_page")
  endPage         Int?          @map("end_page")
  note            String?       @db.VarChar(2000)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  student     User               @relation(fields: [studentId], references: [id], onDelete: Restrict)
  studentBook StudentBook        @relation(fields: [studentBookId], references: [id], onDelete: Restrict)
  reflection  ReadingReflection?

  @@index([studentId, readingDate])
  @@index([studentId, status])
  @@index([studentBookId])
  @@index([readingDate])
  @@map("reading_sessions")
}

model ReadingReflection {
  id                  String   @id @default(uuid()) @db.Uuid
  sessionId           String   @unique @map("session_id") @db.Uuid
  studentId           String   @map("student_id") @db.Uuid
  whatRead            String?  @map("what_read") @db.VarChar(4000)
  learned             String?  @db.VarChar(4000)
  keyIdeas            String?  @map("key_ideas") @db.VarChar(4000)
  application         String?  @db.VarChar(4000)
  keyTakeaway         String?  @map("key_takeaway") @db.VarChar(500)
  understandingRating Int?     @map("understanding_rating") @db.SmallInt
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  session  ReadingSession            @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student  User                      @relation(fields: [studentId], references: [id], onDelete: Restrict)
  tags     ReflectionTagAssignment[]
  feedback TrainerFeedback[]

  @@index([studentId, createdAt])
  @@map("reading_reflections")
}

model ReflectionTag {
  id        String   @id @default(uuid()) @db.Uuid
  /// Stored lowercase.
  name      String   @unique @db.VarChar(40)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  assignments ReflectionTagAssignment[]

  @@map("reflection_tags")
}

model ReflectionTagAssignment {
  reflectionId String @map("reflection_id") @db.Uuid
  tagId        String @map("tag_id") @db.Uuid

  reflection ReadingReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  tag        ReflectionTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([reflectionId, tagId])
  @@index([tagId])
  @@map("reflection_tag_assignments")
}

model TrainerFeedback {
  id           String   @id @default(uuid()) @db.Uuid
  reflectionId String   @map("reflection_id") @db.Uuid
  trainerId    String   @map("trainer_id") @db.Uuid
  body         String   @db.VarChar(2000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  reflection ReadingReflection @relation(fields: [reflectionId], references: [id], onDelete: Cascade)
  trainer    User              @relation(fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([reflectionId])
  @@map("trainer_feedback")
}

/// Goal history: the row with the latest effective_from is the current goal.
model ReadingGoal {
  id            String   @id @default(uuid()) @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  dailyMinutes  Int      @map("daily_minutes")
  weeklyMinutes Int      @map("weekly_minutes")
  daysPerWeek   Int      @map("days_per_week") @db.SmallInt
  monthlyBooks  Int?     @map("monthly_books") @db.SmallInt
  effectiveFrom DateTime @map("effective_from") @db.Date
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, effectiveFrom])
  @@map("reading_goals")
}

// ---------------------------------------------------------------------------
// Configuration and audit
// ---------------------------------------------------------------------------

/// Single-row table (id = 1) of institution-wide settings.
model SystemSettings {
  id                      Int      @id @default(1)
  institutionName         String   @default("School Library") @map("institution_name") @db.VarChar(150)
  timeZone                String   @default("Asia/Phnom_Penh") @map("time_zone") @db.VarChar(64)
  /// Minimum completed reading minutes for a day to count toward streaks/consistency.
  minDailyMinutes         Int      @default(10) @map("min_daily_minutes")
  defaultDailyMinutes     Int      @default(20) @map("default_daily_minutes")
  defaultWeeklyMinutes    Int      @default(120) @map("default_weekly_minutes")
  defaultDaysPerWeek      Int      @default(5) @map("default_days_per_week")
  defaultMonthlyBooks     Int?     @default(1) @map("default_monthly_books")
  maxSessionMinutes       Int      @default(240) @map("max_session_minutes")
  manualEntryMaxDays      Int      @default(7) @map("manual_entry_max_days")
  inactiveAfterDays       Int      @default(7) @map("inactive_after_days")
  /// When true, students can create their own accounts on the sign-in page.
  selfRegistrationEnabled Boolean  @default(false) @map("self_registration_enabled")
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("system_settings")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  action     String   @db.VarChar(80)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String?  @map("entity_id") @db.VarChar(64)
  /// Non-sensitive context (never passwords, tokens or reflection text).
  metadata   Json?
  ip         String?  @db.VarChar(64)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
  @@index([actorId])
  @@map("audit_logs")
}
