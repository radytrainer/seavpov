# Site configuration for ${DOMAIN}. Rendered by the nginx image at start-up (envsubst only
# replaces variables that exist in the container environment, so $host etc. are kept).

# HTTP: Let's Encrypt challenges, then redirect everything to https://${DOMAIN}.
server {
  listen 80 default_server;
  server_name ${DOMAIN} www.${DOMAIN} _;
  location /.well-known/acme-challenge/ { root /var/www/certbot; }
  location / { return 301 https://${DOMAIN}$request_uri; }
}

# HTTPS for any other host name (e.g. the raw IP address): send to the canonical domain.
server {
  listen 443 ssl default_server;
  http2 on;
  server_name _ www.${DOMAIN};
  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  return 301 https://${DOMAIN}$request_uri;
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/nginx/certs/fullchain.pem;
  ssl_certificate_key /etc/nginx/certs/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 1d;

  include /etc/nginx/snippets/security-headers.conf;
  # The web app sends some of these too; keep a single copy (nginx's).
  proxy_hide_header X-Frame-Options;
  proxy_hide_header X-Content-Type-Options;
  proxy_hide_header Referrer-Policy;

  proxy_http_version 1.1;
  proxy_set_header Host $host;
  proxy_set_header X-Real-IP $remote_addr;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header Connection "";
  proxy_read_timeout 60s;

  # Health checks and API docs are for the internal network only.
  location /health { deny all; }
  location /api/docs { deny all; }

  location /api/v1/ {
    limit_req zone=perip burst=60 nodelay;
    # PDFs and CSV exports can take a few seconds for large classes.
    proxy_read_timeout 120s;
    proxy_pass http://api;
  }

  # Hashed assets under /_next/static/ already carry "Cache-Control: immutable" from Next.js.
  # No add_header / proxy_set_header inside locations: either would discard the server-level
  # security headers or proxy headers above (nginx does not merge them).
  location / {
    limit_req zone=perip burst=60 nodelay;
    proxy_pass http://web;
  }
}
