# Production configuration for docker-compose.prod.yml (AWS EC2, Ubuntu).
# On the server: cp .env.production.example .env.production && chmod 600 .env.production
# then replace every __placeholder__. Never commit .env.production.
# Generate secrets with: openssl rand -base64 32 | tr -d '/+=' | cut -c1-32

# --- Domain -------------------------------------------------------------
DOMAIN=pn-seavpov.store
# Public URL of the application (no trailing slash) — must match DOMAIN.
APP_ORIGIN=https://pn-seavpov.store
# Also request a certificate for www.<domain> (needs a DNS record for www).
INCLUDE_WWW=true
# Let's Encrypt expiry notices
LETSENCRYPT_EMAIL=__your_email@example.com__
TIME_ZONE=Asia/Phnom_Penh

# --- Database ---------------------------------------------------------------
POSTGRES_USER=reading
POSTGRES_PASSWORD=__generate_a_long_random_password__
POSTGRES_DB=reading_tracker
DATABASE_POOL_MAX=10

# --- API --------------------------------------------------------------------
LOG_LEVEL=info
SESSION_TTL_HOURS=168
AUTH_RATE_LIMIT_PER_MINUTE=30
GLOBAL_RATE_LIMIT_PER_MINUTE=600

# Optional SMTP for password-reset emails (leave SMTP_HOST empty to disable).
# With Amazon SES: SMTP_HOST=email-smtp.<region>.amazonaws.com, SMTP_PORT=587.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="សៀវភៅ PN <no-reply@pn-seavpov.store>"

# First administrator (used once by deploy/bootstrap-admin.sh; remove the password afterwards)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__temporary_strong_password__
ADMIN_FULL_NAME=System Administrator
ADMIN_EMAIL=

# --- Host paths and ports -------------------------------------------------------
CERTS_DIR=./infra/certs
CERTBOT_WEBROOT=./infra/certbot-www
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=14
HTTP_PORT=80
HTTPS_PORT=443
IMAGE_TAG=latest

# --- Optional off-server backups to Amazon S3 (deploy/backup-to-s3.sh) --------------
# Use an EC2 instance role with s3:PutObject/ListBucket on this bucket (no keys on disk).
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=pn-seavpov/db
AWS_REGION=ap-southeast-1
